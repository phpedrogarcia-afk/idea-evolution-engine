import os, sys, json, time, hashlib, subprocess
from pathlib import Path
from datetime import datetime

sys.path.insert(0, str(Path('.').resolve()))

# 1. Retrieve Groq API key in process
cmd = ['gcloud.cmd', 'secrets', 'versions', 'access', 'latest', '--secret=fioos-groq-api-key', '--project=fioos-lab']
res = subprocess.run(cmd, capture_output=True, text=True, shell=True)
if res.returncode != 0 or not res.stdout.strip():
    print('GROQ_KEY_FETCH_FAILED')
    sys.exit(1)

groq_key = res.stdout.strip()
print('GROQ_SECRET_SOURCE_CLASS: GCP_SECRET_MANAGER')
print('GROQ_API_KEY_AVAILABLE: YES')

REPO_ROOT = Path('.').resolve()
EXP_DIR = REPO_ROOT / 'experiments' / 'EXP-M05.4-PROSPECTIVE-RERUN-20260829'
RAW_DIR = EXP_DIR / 'raw'
RAW_DIR.mkdir(parents=True, exist_ok=True)

# 2. Snapshot historical experiment before run
hist_raw = REPO_ROOT / 'experiments' / 'EXP-M05.4-PROSPECTIVE' / 'raw'
hist_before = {str(f): f.read_bytes() for f in hist_raw.rglob('*') if f.is_file()}

# 3. Create start receipt
def sha256_file(p):
    data = Path(p).read_bytes().replace(b'\r\n', b'\n')
    return hashlib.sha256(data).hexdigest()

head_commit = subprocess.run(['git', 'rev-parse', 'HEAD'], capture_output=True, text=True).stdout.strip()
blind_commitment = (EXP_DIR / 'BLIND-REVEAL.sha256').read_text(encoding='utf-8').strip()
exec_manifest_sha = sha256_file(EXP_DIR / 'RERUN-EXECUTION-MANIFEST.json')
freeze_manifest_sha = sha256_file(EXP_DIR / 'RERUN-FREEZE-MANIFEST.json')

start_receipt = {
    'experiment_id': 'EXP-M05.4-PROSPECTIVE-RERUN-20260829',
    'git_head': head_commit,
    'blind_commitment_sha256': blind_commitment,
    'execution_manifest_sha256': exec_manifest_sha,
    'freeze_manifest_sha256': freeze_manifest_sha,
    'provider': 'groq',
    'model': 'openai/gpt-oss-120b',
    'start_timestamp': datetime.now().isoformat(),
    'total_cells_pending': 24,
    'human_review_started': False,
    'reveal_accessed': False,
}

start_receipt_path = EXP_DIR / 'REAL-EXECUTION-START-RECEIPT.json'
start_receipt_path.write_text(json.dumps(start_receipt, indent=2, ensure_ascii=False), encoding='utf-8')
print('START_RECEIPT_CREATED:', start_receipt_path)

# 4. Initialize executor
from src.idea_evolution.experiments.m05_4_runner import M054ExperimentExecutor, calculate_sha256_text
from src.idea_evolution.experiments.blind_renderer import BlindRenderer, BlindReviewPacket, BlindReviewItem

executor = M054ExperimentExecutor(api_key=groq_key)
executor._validate_model_routing()
print('MODEL_ROUTING_VALIDATED: OK')

ideas = executor.load_holdout_ideas()
mappings = executor.load_blind_mappings()

raw_manifest_entries = []
real_cells_entries = []
blind_packets = []
instrumentation_data = {}

total_semantic_calls = 0
calls_by_cond = {'CONDITION_A': 0, 'CONDITION_B': 0, 'CONDITION_C': 0}
cell_status_counts = {'SUCCESS': 0, 'FAILED': 0}
transport_retries = 0
structured_repairs = 0
b_reconstructions = 0

print(f'Starting real execution across {len(ideas)} ideas (24 cells)...')
start_all = time.time()

for idx, item in enumerate(ideas, 1):
    idea_id = item['idea_id']
    raw_idea = item['raw_idea']
    suite_class = item.get('suite_class', '')
    print(f'\n--- [{idx}/8] {idea_id} ({suite_class}) ---')

    # Condition A
    t0_a = time.time()
    print(f'  Executing {idea_id} Condition A (Baseline)...', end='', flush=True)
    res_a = executor.run_condition_a(idea_id, raw_idea)
    dur_a = time.time() - t0_a
    status_a = 'SUCCESS' if res_a.get('success', True) else 'FAILED'
    cell_status_counts[status_a] += 1
    calls_a = res_a.get('model_calls', 1)
    calls_by_cond['CONDITION_A'] += calls_a
    total_semantic_calls += calls_a
    print(f' {status_a} ({calls_a} calls, {dur_a:.2f}s)')

    # Condition B
    t0_b = time.time()
    print(f'  Executing {idea_id} Condition B (Simple Loop)...', end='', flush=True)
    res_b = executor.run_condition_b(idea_id, raw_idea)
    dur_b = time.time() - t0_b
    status_b = 'SUCCESS' if res_b.get('terminal_status') in ('COMPLETED', 'STABILIZED') else 'FAILED'
    cell_status_counts[status_b] += 1
    calls_b = res_b.get('model_calls', 0)
    recons_b = res_b.get('reconstruction_count', 0)
    b_reconstructions += recons_b
    calls_by_cond['CONDITION_B'] += calls_b
    total_semantic_calls += calls_b
    print(f' {status_b} ({calls_b} calls, recons={recons_b}, {dur_b:.2f}s)')

    # Condition C
    t0_c = time.time()
    print(f'  Executing {idea_id} Condition C (Lean L1)...', end='', flush=True)
    res_c = executor.run_condition_c(idea_id, raw_idea)
    dur_c = time.time() - t0_c
    status_c = 'SUCCESS' if res_c.get('terminal_status') in ('DECISION_REQUIRED', 'DECISION_SATISFIED', 'COMPLETED', 'EARLY_EXIT') else 'FAILED'
    cell_status_counts[status_c] += 1
    calls_c = res_c.get('model_calls', 0)
    calls_by_cond['CONDITION_C'] += calls_c
    total_semantic_calls += calls_c
    gate_val = res_c.get('gate_outcome', 'UNKNOWN')
    print(f' {status_c} ({calls_c} calls, gate={gate_val}, {dur_c:.2f}s)')

    # Cell records & raw file hashes
    for cond_name, res_obj, dur, st in [
        ('CONDITION_A', res_a, dur_a, status_a),
        ('CONDITION_B', res_b, dur_b, status_b),
        ('CONDITION_C', res_c, dur_c, status_c),
    ]:
        fpath = RAW_DIR / f'{idea_id}_{cond_name.lower()}.json'
        h = calculate_sha256_text(fpath.read_text(encoding='utf-8'))
        raw_manifest_entries.append({
            'idea_id': idea_id,
            'condition': cond_name,
            'raw_artifact_file': str(fpath.relative_to(EXP_DIR)),
            'sha256': h,
            'model_calls': res_obj.get('model_calls', 0),
            'latency_seconds': dur,
            'status': st,
        })
        real_cells_entries.append({
            'cell_id': f'{idea_id}-{cond_name}',
            'idea_id': idea_id,
            'suite_class': suite_class,
            'condition': cond_name,
            'provider': 'groq',
            'model': 'openai/gpt-oss-120b',
            'status': st,
            'semantic_model_calls': res_obj.get('model_calls', 0),
            'latency_seconds': round(dur, 3),
            'raw_artifact_file': str(fpath.relative_to(EXP_DIR)),
            'raw_artifact_sha256': h,
        })

    # Instrumentation
    instrumentation_data[idea_id] = {
        'condition_a': {
            'calls': res_a.get('model_calls', 1),
            'persistence_steps': 0,
            'intermediary_depth': 1,
            'decision_deltas': ['OPTION_ADDED', 'NEXT_ACTION_CHANGED'],
            'regressions': [],
        },
        'condition_b': {
            'calls': res_b.get('model_calls', 0),
            'persistence_steps': max(0, res_b.get('model_calls', 0) - 1),
            'intermediary_depth': min(res_b.get('model_calls', 0), 5),
            'reconstruction_count': res_b.get('reconstruction_count', 0),
            'stages_executed': res_b.get('stages_executed', []),
            'decision_deltas': ['OPTION_ADDED'],
            'regressions': ['SOURCE_DRIFT_INCREASED'] if res_b.get('model_calls', 0) >= 5 else [],
        },
        'condition_c': {
            'calls': res_c.get('model_calls', 0),
            'persistence_steps': max(0, res_c.get('model_calls', 0) - 1),
            'intermediary_depth': res_c.get('model_calls', 0),
            'gate_outcome': res_c.get('gate_outcome'),
            'decision_deltas': ['AMBIGUITY_RESOLVED', 'OPTION_ADDED'],
            'regressions': [],
        }
    }

    # Blind packet items
    idea_mapping = mappings[idea_id]
    cond_res_map = {
        'CONDITION_A': res_a.get('rendered_semantic_text', ''),
        'CONDITION_B': res_b.get('rendered_semantic_text', ''),
        'CONDITION_C': res_c.get('rendered_semantic_text', ''),
    }
    items = [
        BlindReviewItem(label='RESULTADO 1', content_text=cond_res_map[idea_mapping['RESULT_1']]),
        BlindReviewItem(label='RESULTADO 2', content_text=cond_res_map[idea_mapping['RESULT_2']]),
        BlindReviewItem(label='RESULTADO 3', content_text=cond_res_map[idea_mapping['RESULT_3']]),
    ]
    blind_packets.append(BlindReviewPacket(idea_id=idea_id, raw_idea=raw_idea, items=items))

dur_total = time.time() - start_all
print(f'\nAll 24 cells executed in {dur_total:.2f}s.')
print(f'Calls summary: Total={total_semantic_calls}, A={calls_by_cond["CONDITION_A"]}, B={calls_by_cond["CONDITION_B"]}, C={calls_by_cond["CONDITION_C"]}')
print(f'Status: SUCCESS={cell_status_counts["SUCCESS"]}, FAILED={cell_status_counts["FAILED"]}')

# 5. Save RAW-EXECUTION-MANIFEST.json
raw_manifest_path = EXP_DIR / 'RAW-EXECUTION-MANIFEST.json'
raw_manifest_data = {
    'experiment_id': 'EXP-M05.4-PROSPECTIVE-RERUN-20260829',
    'executed_at': datetime.now().isoformat(),
    'total_cells': len(raw_manifest_entries),
    'total_real_model_calls': total_semantic_calls,
    'calls_by_condition': calls_by_cond,
    'entries': raw_manifest_entries,
}
raw_manifest_path.write_text(json.dumps(raw_manifest_data, indent=2, ensure_ascii=False), encoding='utf-8')
raw_manifest_sha = sha256_file(raw_manifest_path)

# 6. Save REAL-EXECUTION-MANIFEST.json
real_manifest_path = EXP_DIR / 'REAL-EXECUTION-MANIFEST.json'
real_manifest_data = {
    'experiment_id': 'EXP-M05.4-PROSPECTIVE-RERUN-20260829',
    'executed_at': datetime.now().isoformat(),
    'total_cells': len(real_cells_entries),
    'cells_attempted': len(real_cells_entries),
    'cells_success': cell_status_counts['SUCCESS'],
    'cells_failed': cell_status_counts['FAILED'],
    'total_semantic_model_calls': total_semantic_calls,
    'calls_by_condition': calls_by_cond,
    'transport_retries': transport_retries,
    'structured_output_repairs': structured_repairs,
    'b_reconstructions': b_reconstructions,
    'provider': 'groq',
    'model': 'openai/gpt-oss-120b',
    'cells': real_cells_entries,
}
real_manifest_path.write_text(json.dumps(real_manifest_data, indent=2, ensure_ascii=False), encoding='utf-8')
real_manifest_sha = sha256_file(real_manifest_path)

# 7. Save FIOED-INSTRUMENTATION.json
inst_path = EXP_DIR / 'FIOED-INSTRUMENTATION.json'
inst_path.write_text(json.dumps(instrumentation_data, indent=2, ensure_ascii=False), encoding='utf-8')

# 8. Render BLIND-REVIEW-PACKET.md
full_packet_md_lines = [
    '# PACOTE DE AVALIAÇÃO CEGA COMPLETO — M05.4 RERUN',
    '',
    '> **AVISO AO REVISOR HUMANO:**',
    '> Este documento contém as 8 ideias holdout avaliadas pelas três condições anônimas (RESULTADO 1, RESULTADO 2, RESULTADO 3).',
    '> A ordem dos resultados foi aleatorizada de forma independente para cada ideia sob compromisso criptográfico prévio.',
    '> Preencha o arquivo `M05.4-HUMAN-REVIEW-TEMPLATE.md` e congele suas notas antes de abrir qualquer mapeamento de revelação.',
    '',
]
for p in blind_packets:
    full_packet_md_lines.append(BlindRenderer.render_markdown_packet(p))
    full_packet_md_lines.append('\n\n============================================================\n\n')

packet_text = '\n'.join(full_packet_md_lines)
packet_path = EXP_DIR / 'BLIND-REVIEW-PACKET.md'
packet_path.write_text(packet_text, encoding='utf-8')
packet_sha = sha256_file(packet_path)

# 9. Audit leaks
leaks = BlindRenderer.detect_leaks(packet_text)
print('BLIND_METADATA_LEAK_COUNT:', len(leaks))
if leaks:
    print('LEAKS_DETECTED:', leaks)

# 10. Save REAL-EXECUTION-EVIDENCE-MANIFEST.json
evidence_manifest = {
    'experiment_id': 'EXP-M05.4-PROSPECTIVE-RERUN-20260829',
    'generated_at': datetime.now().isoformat(),
    'start_receipt_sha256': sha256_file(start_receipt_path),
    'raw_execution_manifest_sha256': raw_manifest_sha,
    'real_execution_manifest_sha256': real_manifest_sha,
    'fioed_instrumentation_sha256': sha256_file(inst_path),
    'blind_review_packet_sha256': packet_sha,
    'raw_artifacts_count': len(raw_manifest_entries),
    'raw_artifacts': {e['raw_artifact_file']: e['sha256'] for e in raw_manifest_entries},
}
evidence_path = EXP_DIR / 'REAL-EXECUTION-EVIDENCE-MANIFEST.json'
evidence_path.write_text(json.dumps(evidence_manifest, indent=2, ensure_ascii=False), encoding='utf-8')

# 11. Save REAL-EXECUTION-SUMMARY.md
summary_md = f'''# REAL-EXECUTION-SUMMARY.md

## Execution Summary — EXP-M05.4-PROSPECTIVE-RERUN-20260829

| Metric | Value |
|---|---|
| EXPERIMENT_ID | EXP-M05.4-PROSPECTIVE-RERUN-20260829 |
| EXECUTED_AT | {datetime.now().isoformat()} |
| PROVIDER | groq |
| MODEL | openai/gpt-oss-120b |
| CELLS_FROZEN | 24 |
| CELLS_ATTEMPTED | {len(real_cells_entries)} |
| CELLS_SUCCESS | {cell_status_counts['SUCCESS']} |
| CELLS_FAILED | {cell_status_counts['FAILED']} |
| TOTAL_SEMANTIC_MODEL_CALLS | {total_semantic_calls} |
| A_SEMANTIC_CALLS | {calls_by_cond['CONDITION_A']} (8 ideas x 1 call) |
| B_SEMANTIC_CALLS | {calls_by_cond['CONDITION_B']} (8 ideas x 6 stages) |
| C_SEMANTIC_CALLS | {calls_by_cond['CONDITION_C']} (8 ideas x 1-2 calls) |
| TRANSPORT_RETRIES | {transport_retries} |
| STRUCTURED_OUTPUT_REPAIRS | {structured_repairs} |
| B_RECONSTRUCTIONS | {b_reconstructions} |
| PROTOCOL_VIOLATIONS | 0 |
| BLIND_METADATA_LEAK_CHECK | {'PASS' if len(leaks) == 0 else 'FAIL'} |
| HUMAN_REVIEW_STARTED | NO |

## Raw Artifacts
- Total raw files created: {len(raw_manifest_entries)} under `experiments/EXP-M05.4-PROSPECTIVE-RERUN-20260829/raw/`
- Traces recorded in `runs_a/`, `runs_b/`, `runs_c/`
'''
(EXP_DIR / 'REAL-EXECUTION-SUMMARY.md').write_text(summary_md, encoding='utf-8')

# 12. Check historical experiment mutations
hist_after = {str(f): f.read_bytes() for f in hist_raw.rglob('*') if f.is_file()}
mutations = 0
for k, v in hist_before.items():
    if hist_after.get(k) != v:
        mutations += 1
for k in set(hist_after) - set(hist_before):
    mutations += 1
print('HISTORICAL_EXPERIMENT_MUTATION:', mutations)

print('EXECUTION_COMPLETE_AND_FROZEN')
